# ============================================================================
# bili-music-segmenter 环境变量配置
#
# 使用方法：
#   1) 复制本文件为 .env          cp .env.example .env
#   2) 按下面的注释填写【必填】项
#   3) 不要提交 .env 到 git（已在 .gitignore 中）
#
# 变量优先级：.env 文件 > docker-compose.yml 中的默认值
# 留空的变量不会生效（compose 的 ${VAR:-default} 语法）
# ============================================================================


# ┌──────────────────────────────────────────────────────────────────────────┐
# │ 一、必填项 —— 不填无法启动                                                │
# └──────────────────────────────────────────────────────────────────────────┘

# 【必填】录播成品所在目录（宿主机绝对路径，不要带引号）
#   容器内会挂载为 /recording，切歌服务只扫描这个目录下的视频文件
#   configs/biliWatcher.yaml 中的 glob 规则固定为 /recording/*
#
#   典型场景：
#     - bililive-tools 录制：        /vol1/1000/biliLive-tools/video/Bilibili
#     - 本仓库自带的 rec_merge 输出： /vol1/1000/biliup/data/rec/merged
#     - 自己手动放的成品：            /mnt/media/to-cut
#
#   注意：
#     - 必须是已存在的目录，否则 docker 会自动创建空目录导致扫不到文件
#     - 权限需允许容器内 uid 1000 读取；建议 chmod 755 该目录
#     - 含中文或空格的路径可以正常使用，不要加引号
RECORDING_DIR=

# 【必填】B 站投稿分区 ID（数字）
#   决定切片上传到哪个分区。常用值：
#     31  = 音乐 / 翻唱       ← 本项目的默认场景
#     21  = 日常
#     138 = 搞笑
#     145 = ​​音乐综合
#   完整列表见 B 站创作中心投稿页面的「分区」下拉框，或访问：
#     https://api.bilibili.com/x/web-interface/archive/type/list
UPLOAD_TID=31

# 【必填】转载类型
#   1 = 自制（原创作品）
#   2 = 转载（切片、搬运、二创归档）
#
#   本项目的典型场景是「切直播录播上传」，属于转载，保持 2 即可。
#   填 1 会被 B 站判定为自制声明，与实际不符可能影响审核。
UPLOAD_COPYRIGHT=2


# ┌──────────────────────────────────────────────────────────────────────────┐
# │ 二、B 站登录态 —— 必须先手动执行一次 biliup login                          │
# └──────────────────────────────────────────────────────────────────────────┘

# biliup 的 cookie 文件路径（相对于本项目根目录）
#   首次使用必须生成：
#     docker compose run --rm inaseg biliup -u /inaseg/cookies.json login
#   按提示扫码，成功后会在项目根目录生成 cookies.json
#
#   如果不改这项，保持 ./cookies.json 即可（容器内对应 /inaseg/cookies.json）
#   该文件含账号凭据，已在 .gitignore 中，切勿提交或分享
COOKIE_FILE=./cookies.json


# ┌──────────────────────────────────────────────────────────────────────────┐
# │ 三、切歌行为 —— 一般无需修改                                              │
# └──────────────────────────────────────────────────────────────────────────┘

# 轮询间隔（秒）：每隔多久扫描一次 RECORDING_DIR 找新文件
#   越小响应越快，但会频繁 stat 目录
#   建议值：60~300。默认 120（2 分钟）
WATCH_INTERVAL=120

# 文件稳定等待（秒）：文件 mtime 距今超过这个值才认为是「写完的」
#   防止正在拷贝/录制的文件被提前处理
#   建议值：10~60。默认 10
STABLE_WAIT=10

# 稳定复检次数：连续 N 轮检查文件大小与 mtime 都不变才处理
#   总耗时 = STABLE_WAIT × (1 + STABLE_CHECKS)
#   默认 2 → 需等待 30 秒。网络盘/慢盘建议调到 3
STABLE_CHECKS=2


# ┌──────────────────────────────────────────────────────────────────────────┐
# │ 四、上传行为                                                              │
# └──────────────────────────────────────────────────────────────────────────┘

# celery 并发数 —— 【强烈建议保持 1，不要改大】
#   B 站对短时间内大量投稿有风控，并发上传极易触发「操作过于频繁」或
#   需要手机验证码。改成 1 以上的值属于自担风险。
CELERY_CONCURRENCY=1

# celery 日志级别：debug | info | warning | error
#   排查问题时用 debug，日常用 info
CELERY_LOGLEVEL=info

# 两场上传之间的间隔（秒）
#   上一场的所有切片传完后，等待这么久才开始传下一场
#   用于进一步降低风控概率。默认 2400（40 分钟）
#   风控频繁时建议调到 3600~7200
UPLOAD_INTERVAL=2400


# ┌──────────────────────────────────────────────────────────────────────────┐
# │ 五、容器与路径 —— 通常无需修改                                            │
# └──────────────────────────────────────────────────────────────────────────┘

# 镜像名称
#   自己 build 时随意；如果用别人的预构建镜像则填对应名字
IMAGE_NAME=ipynb-inaseg

# 工作目录（宿主机相对路径）：存放中间产物、临时切片、日志
#   容器内挂载为 /work
#   要求：磁盘剩余空间 >= 单场录播的 2 倍（切歌要临时复制音频）
WORK_DIR=./work

# 容器重启策略
#   unless-stopped = 除非手动停止，否则总是重启（推荐）
#   always         = 总是重启（含 docker 重启后）
#   no             = 不自动重启
RESTART_POLICY=unless-stopped


# ┌──────────────────────────────────────────────────────────────────────────┐
# │ 六、可选：卡死告警（默认不启用）                                          │
# └──────────────────────────────────────────────────────────────────────────┘
# 这两个变量只在使用 scripts/upload_watch.sh 与 upload_recover.sh 时需要，
# 启用方式见 README「可选：上传卡死告警」一节。

# PushPlus 推送 token（用于卡死时微信提醒）
#   注册地址：https://www.pushplus.plus/
#   留空则告警脚本自动跳过推送，仅写日志
PUSHPLUS_TOKEN=

# 上传卡死判定阈值（小时）：多久没有新上传进展就认为卡死
STALL_HOURS=5
